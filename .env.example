# Copie este ficheiro para `.env` no Vercel/VPS e preencha com os valores reais.
# NUNCA faça commit do .env para git — está no .gitignore.

# URL público do site (usado para montar return_url / cancel_url dos pagamentos)
# Ex.: https://seudominio.pt
SITE_URL=""

# Nome e ID do produto (aparece na UTMify)
PRODUCT_ID="ghostspy-vip"
PRODUCT_NAME="GhostSpy Acesso VIP"

# Pasta/KV onde o backend guarda o histórico de pagamentos.
STORAGE_DIR="/var/www/ghostspy-pt-storage"

# Meta Conversions API (server-side) — pixel principal
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
META_TEST_EVENT_CODE=""

# Meta CAPI — segundo pixel (só Polônia). Deixe vazio para desativar.
META_PIXEL_ID_PL_B=""
META_CAPI_ACCESS_TOKEN_PL_B=""

# TikTok Events API (server-side)
TIKTOK_PIXEL_ID=""
TIKTOK_CAPI_ACCESS_TOKEN=""
TIKTOK_TEST_EVENT_CODE=""

# Painel do cliente (login/senha automáticos pós-compra)
# AUTH_SECRET: chave para assinar os tokens de sessão (string aleatória longa).
# ADMIN_SETUP_SECRET: senha de uso único para criar a conta admin via /api/admin-setup.
AUTH_SECRET=""
ADMIN_SETUP_SECRET=""

# Gateway ZENITH (México MXN + Polônia PLN) — flow -mx e flow -pl
# X-API-Key / X-API-Secret da conta Zenith (app.zenithworld.com.br)
ZENITH_PUBLIC_KEY=""
ZENITH_SECRET_KEY=""
# Segredo gerado por nós e registado no endpoint do webhook (POST /integrations/webhooks/endpoints)
ZENITH_WEBHOOK_SECRET=""
ZENITH_ENVIRONMENT="production"
