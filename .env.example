# CHECKOUT ALFAIABOEMIA (EuronPay) — credenciais
# Copie este ficheiro para `.env` no VPS e preencha com os valores reais.
# NUNCA faça commit do .env para git — está no .gitignore.

ALFAIABOEMIA_BASE_URL="https://app.alfaiaboemia.pt/api"
ALFAIABOEMIA_CLIENT_ID=""
ALFAIABOEMIA_CLIENT_SECRET=""

# URL público do site (usado para montar o callback_url dos pagamentos)
# Ex.: https://seudominio.pt
SITE_URL=""

# Nome e ID do produto (aparece na UTMify)
PRODUCT_ID="ghostspy-vip"
PRODUCT_NAME="GhostSpy Acesso VIP"

# Preço em EUR (string, ex.: "17.90"). Mantenha sincronizado com o preço mostrado na página.
PRODUCT_PRICE="17.90"

# Email e telefone de contacto da loja (para o lembrete Multibanco com failover=1).
STORE_EMAIL=""
STORE_PHONE=""

# Pasta onde o backend guarda o histórico de pagamentos (JSON).
# Tem de ser escrita pelo utilizador do php-fpm (geralmente www-data).
STORAGE_DIR="/var/www/ghostspy-pt-storage"
