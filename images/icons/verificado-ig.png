  <body class="font-inter antialiased">
    <!-- Age Gate GhostSpy (cores do tema Ghost) -->
    <style>
      #ghost-age-gate{position:fixed;inset:0;z-index:2147483000;display:flex;align-items:center;justify-content:center;padding:clamp(16px,4vw,32px);background:radial-gradient(circle at 50% 0%, rgba(14,130,248,0.06) 0%, transparent 60%),#F8FAFC;font-family:Inter,system-ui,-apple-system,sans-serif;-webkit-tap-highlight-color:transparent}
      .ghost-gate-card{width:100%;max-width:640px;background:#FFFFFF;border:1px solid #E2E8F0;border-radius:clamp(18px,4vw,28px);box-shadow:0 25px 60px -15px rgba(15,23,42,0.15),0 2px 6px rgba(15,23,42,0.05);padding:clamp(28px,6vw,56px) clamp(20px,5vw,48px);text-align:center;animation:ghost-gate-card-in .3s ease-out}
      .ghost-gate-icon{width:clamp(64px,13vw,88px);height:clamp(64px,13vw,88px);margin:0 auto clamp(18px,4vw,28px);background:#EFF6FF;border-radius:50%;display:flex;align-items:center;justify-content:center}
      .ghost-gate-icon svg{width:52%;height:52%;color:#0E82F8}
      .ghost-gate-title{color:#0F172A;font-size:clamp(26px,6vw,36px);font-weight:700;line-height:1.15;letter-spacing:-0.02em;margin:0 0 clamp(10px,2.5vw,16px)}
      .ghost-gate-sub{color:#475569;font-size:clamp(15px,3.4vw,19px);margin:0 0 clamp(22px,5vw,34px)}
      .ghost-gate-yes{display:block;width:100%;box-sizing:border-box;border:none;cursor:pointer;user-select:none;background:linear-gradient(135deg,#0E82F8 0%,#0D54A3 100%);color:#FFFFFF;font-family:inherit;font-size:clamp(13px,3.2vw,16px);font-weight:700;letter-spacing:0.04em;text-transform:uppercase;border-radius:clamp(12px,3vw,16px);padding:clamp(16px,4vw,20px) 16px;box-shadow:0 10px 24px -4px rgba(14,130,248,0.38),inset 0 1px 0 rgba(255,255,255,0.22);transition:transform .15s ease,box-shadow .15s ease}
      .ghost-gate-yes:hover{transform:translateY(-1px);box-shadow:0 14px 28px -4px rgba(14,130,248,0.45),inset 0 1px 0 rgba(255,255,255,0.22)}
      .ghost-gate-yes:active{transform:scale(.98)}
      .ghost-gate-yes:focus-visible{outline:none;box-shadow:0 10px 24px -4px rgba(14,130,248,0.38),0 0 0 3px rgba(14,130,248,0.3)}
      .ghost-gate-no{display:block;width:100%;background:none;border:none;cursor:pointer;user-select:none;color:#94A3B8;font-family:inherit;font-size:clamp(12px,3vw,15px);font-weight:600;letter-spacing:0.04em;text-transform:uppercase;padding:clamp(14px,3.5vw,18px) 8px;margin:0;transition:color .15s ease}
      .ghost-gate-no:hover{color:#64748B}
      .ghost-gate-note{color:#94A3B8;font-size:clamp(11px,2.6vw,13px);margin:clamp(8px,2vw,14px) 0 0}
      .ghost-gate-blocked-title{color:#0F172A;font-size:clamp(22px,5vw,30px);font-weight:700;letter-spacing:-0.02em;margin:0 0 10px}
      .ghost-gate-blocked-text{color:#475569;font-size:clamp(14px,3.2vw,17px);margin:0}
      @keyframes ghost-gate-card-in{from{opacity:0;transform:translateY(14px) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}
    </style>
    <script>
      (function () {
        var KEY = "ghost_age_verified";
        var verified = false;
        try { verified = localStorage.getItem(KEY) === "1"; } catch (e) {}
        if (verified) return;

        /* O gate existe APENAS na home da oferta (.ghost-home-scope) — a tela onde
           o Instagram do alvo é adicionado. Em nenhuma outra rota/página.
           Ele é criado via JS porque a hidratação do React Router descarta do body
           qualquer nó estático fora da árvore do app. */
        var GATE_HTML = [
          '<div id="ghost-age-gate" role="dialog" aria-modal="true" aria-label="Verificação de idade">',
          '  <div class="ghost-gate-card">',
          '    <div class="ghost-gate-icon">',
          '      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">',
          '        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>',
          '      </svg>',
          '    </div>',
          '    <div id="ghost-age-main">',
          '      <h2 class="ghost-gate-title">Você tem 18 anos<br/>ou mais?</h2>',
          '      <p class="ghost-gate-sub">Confirme sua idade para continuar.</p>',
          '      <button type="button" id="ghost-age-yes" class="ghost-gate-yes">Sim, tenho 18 anos ou mais</button>',
          '      <button type="button" id="ghost-age-no" class="ghost-gate-no">Não, tenho menos de 18 anos</button>',
          '      <p class="ghost-gate-note">Ao continuar, você confirma ter lido e aceito os termos de uso.</p>',
          '    </div>',
          '    <div id="ghost-age-blocked" hidden>',
          '      <h2 class="ghost-gate-blocked-title">Conteúdo restrito</h2>',
          '      <p class="ghost-gate-blocked-text">O acesso ao GhostSpy é permitido apenas para maiores de 18 anos.</p>',
          '    </div>',
          '  </div>',
          '</div>'
        ].join("\n");

        var gate = null, viewSent = false, mo = null;
        function dl(ev) {
          try {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({ event: ev });
          } catch (e) {}
        }
        function buildGate() {
          var host = document.createElement("div");
          host.innerHTML = GATE_HTML;
          gate = host.firstElementChild;
          document.body.appendChild(gate);
          document.body.style.overflow = "hidden";
          var yes = gate.querySelector("#ghost-age-yes");
          var no = gate.querySelector("#ghost-age-no");
          if (yes) {
            yes.addEventListener("click", function () {
              verified = true;
              dl("age_gate_confirm");
              try { localStorage.setItem(KEY, "1"); } catch (e) {}
              if (mo) mo.disconnect();
              document.body.style.overflow = "";
              gate.style.transition = "opacity .25s ease";
              gate.style.opacity = "0";
              setTimeout(function () { if (gate) { gate.remove(); gate = null; } }, 250);
            });
          }
          if (no) {
            no.addEventListener("click", function () {
              dl("age_gate_reject");
              var main = gate.querySelector("#ghost-age-main");
              var blocked = gate.querySelector("#ghost-age-blocked");
              if (main) main.hidden = true;
              if (blocked) blocked.hidden = false;
            });
          }
        }
        function destroyGate() {
          if (gate) { gate.remove(); gate = null; }
          document.body.style.overflow = "";
        }
        function syncGate() {
          if (verified) return;
          var onHome = !!document.querySelector(".ghost-home-scope");
          if (onHome && !gate) {
            buildGate();
            if (!viewSent) { viewSent = true; dl("age_gate_view"); }
          } else if (!onHome && gate) {
            destroyGate();
          }
        }
        syncGate();
        mo = new MutationObserver(syncGate);
        mo.observe(document.documentElement, { childList: true, subtree: true });
      })();
    </script>
    <!-- End Age Gate GhostSpy -->
